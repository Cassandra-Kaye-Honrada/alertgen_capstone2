<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient background -  -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#4DDAD0"
                android:centerColor="#3BC6BE"
                android:endColor="#2BA9A1"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Large outer circle on right -->
    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="end|center_vertical"
        android:right="-40dp">
        <shape android:shape="oval">
            <solid android:color="#1A0A5A52" />
        </shape>
    </item>

    <!-- Medium circle -->
    <item
        android:width="130dp"
        android:height="130dp"
        android:gravity="end|center_vertical"
        android:right="-15dp">
        <shape android:shape="oval">
            <solid android:color="#26084E47" />
        </shape>
    </item>

    <!-- Small inner circle -->
    <item
        android:width="80dp"
        android:height="80dp"
        android:gravity="end|center_vertical"
        android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="#33064239" />
        </shape>
    </item>

</layer-list>