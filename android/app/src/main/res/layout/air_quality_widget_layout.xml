<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:background="@drawable/air_quality_widget_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:id="@+id/air_quality_widget_container"
        android:elevation="6dp">

        <!-- AQI Value and Label -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/aqi_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="••"
                android:textSize="48sp"
                android:textColor="#000000"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AQI"
                android:textSize="12sp"
                android:textColor="#666666"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="2dp" />

        

        </LinearLayout>

        <!-- Right Section: Details -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:orientation="vertical"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Air Quality Index"
                android:textSize="12sp"
                android:textColor="#666666"
                android:fontFamily="sans-serif"
                android:gravity="center" />

            <!-- Quality Level -->
            <TextView
                android:id="@+id/quality_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="18sp"
                android:textColor="#000000"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp" />

            <!-- Dominant Pollutant -->
            <TextView
                android:id="@+id/dominant_pollutant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="14sp"
                android:textColor="#666666"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="6dp" />

            <!-- Location -->
            <TextView
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="12sp"
                android:textColor="#666666"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="6dp" />

            <!-- Timestamp and Refresh -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Updated: Just now"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:fontFamily="sans-serif"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/refresh_button"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_popup_sync"
                    android:tint="#000000"
                    android:contentDescription="Refresh data" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>