<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/air_quality_widget_bg">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="start|center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_location_pin"
                android:tint="#666666"
                android:layout_marginEnd="8dp"
                android:contentDescription="Location icon" />

            <TextView
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="15sp"
                android:textColor="#000000"
                android:textStyle="normal" />
        </LinearLayout>

          <TextView
                android:id="@+id/timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Updated: Just now"
                android:textSize="13sp"
                android:textStyle="italic"
                android:textColor="#888888" />


        <ImageView
            android:id="@+id/refresh_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#000"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh data"
            android:tooltipText="Refresh data" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/air_quality_widget_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_bar"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingEnd="24dp">

            <RelativeLayout
                android:layout_width="130dp"
                android:layout_height="130dp">

                <ProgressBar
                    android:id="@+id/circular_progress_good"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_good"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/circular_progress_satisfactory"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_satisfactory"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/circular_progress_moderate"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_moderate"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/circular_progress_poor"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_poor"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/circular_progress_very_poor"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_very_poor"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/circular_progress_severe"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_severe"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/aqi_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="••"
                    android:textSize="32sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:layout_centerInParent="true" />
            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start|center_vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/aqi_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Air Quality Index"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/quality_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="22sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/dominant_pollutant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="15sp"
                android:textColor="#666666"
                android:layout_marginBottom="5dp" />

        
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>