<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="@drawable/air_quality_widget_bg">

    <LinearLayout
        android:id="@+id/air_quality_widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Left Section: Circular Progress Ring + AQI label outside -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingEnd="16dp">

            <!-- Progress Ring -->
            <RelativeLayout
                android:layout_width="120dp"
                android:layout_height="120dp">

                <!-- 6 Progress Bars (only one visible at a time) -->
                <ProgressBar
                    android:id="@+id/circular_progress_good"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_good"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/circular_progress_satisfactory"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_satisfactory"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/circular_progress_moderate"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_moderate"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/circular_progress_poor"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_poor"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/circular_progress_very_poor"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_very_poor"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/circular_progress_severe"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="500"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_severe"
                    android:visibility="gone" />

                <!-- AQI Value inside ring -->
                <TextView
                    android:id="@+id/aqi_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="••"
                    android:textSize="28sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:layout_centerInParent="true" />
            </RelativeLayout>

          
        </LinearLayout>

        <!-- Right Section: Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start|center_vertical">
            <TextView
                android:id="@+id/aqi_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Air Quality Index"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="6dp" />
            <TextView
                android:id="@+id/quality_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="18sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/dominant_pollutant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="6dp" />

            <!-- Location with pin icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_location_pin"
                    android:tint="#666666"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Location icon" />

                <TextView
                    android:id="@+id/location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Timestamp + Refresh -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Updated: Just now"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/refresh_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_popup_sync"
                    android:tint="#4CAF50"
                    android:padding="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Refresh data"
                    android:tooltipText="Refresh data" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
