<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:background="@drawable/emergency_widget_square_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:id="@+id/emergency_widget_container"
        android:elevation="6dp">

       
        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/emergency_icon_square"
            android:contentDescription="Emergency Call"
             android:layout_marginTop="40dp"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp" />

              <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call for Help"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</FrameLayout>