<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:background="@drawable/emergency_widget_horizontal_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:id="@+id/emergency_widget_container_horizontal"
        android:elevation="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Call for help"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif"
            android:gravity="start"
            android:lineSpacingExtra="2dp"
            android:paddingStart="8dp"
            android:paddingEnd="0dp" />

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/emergency_icon_horizontal"
            android:contentDescription="Emergency Call"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp" />

    </LinearLayout>
</FrameLayout>